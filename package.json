{
  "name": "tickplate",
  "version": "1.1.0",
  "author": "Timur Shemsedinov <timur.shemsedinov@gmail.com>",
  "description": "Back-tick templates for JavaScript",
  "license": "MIT",
  "keywords": [
    "tickplate",
    "metarhia",
    "tick",
    "backtick",
    "template",
    "templating"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metarhia/tickplate.git"
  },
  "bugs": {
    "url": "https://github.com/metarhia/tickplate/issues",
    "email": "timur.shemsedinov@gmail.com"
  },
  "homepage": "https://metarhia.com",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/tshemsedinov"
  },
  "main": "tickplate.js",
  "types": "tickplate.d.ts",
  "exports": {
    ".": {
      "require": "./tickplate.js",
      "import": "./tickplate.js",
      "types": "./tickplate.d.ts"
    }
  },
  "files": [
    "tickplate.js",
    "tickplate.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "readmeFilename": "README.md",
  "scripts": {
    "test": "npm run lint && npm run types && node ./test.js",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier -c \"**/*.js\" \"**/*.json\" \"**/*.md\"",
    "fix": "prettier --write \"**/*.js\" \"**/*.json\" \"**/*.md\""
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-metarhia": "^9.1.9",
    "metaskills": "^1.0.4",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3"
  }
}
